# --- Discord application (https://discord.com/developers/applications) ---
# Bot token of the application. Used for the gateway connection (receiving
# interactions) and REST calls (registering commands, followup messages).
DISCORD_TOKEN=
# Application ID
DISCORD_APPLICATION_ID=
# Public key of the application — only needed in HTTP endpoint mode
# (DISCORD_GATEWAY=false) to verify interaction signatures.
DISCORD_PUBLIC_KEY=
# Receive interactions over the gateway websocket (default; needs the bot user
# declared on the app, no public URL required). Set to false to use the HTTP
# interactions endpoint instead (needs a public HTTPS URL in the dev portal).
DISCORD_GATEWAY=true
# Gateway intents bitfield — interactions need none, so 0 is fine
DISCORD_INTENTS=0
# Discord user ID of the owner (has all permissions, can assign host roles)
DISCORD_OWNER_ID=
# Optional: restrict interactions to this guild ID (commands are also registered
# as guild commands there for instant updates). Note: when set, user-install DM
# interactions (no guild) are rejected — leave unset to allow DM usage.
#DISCORD_GUILD_ID=

# --- Bridge ---
PORT=3000
# Data directory (mount as a volume in Docker so it survives updates)
DATA_DIR=/data
# Public hostname players use to connect to Archipelago servers
AP_SERVER_HOST=localhost
# First port used for Archipelago servers (one per running game)
BASE_PORT=38281
# Set to false to disable the /hints command
HINTS_ENABLED=true
# Max attachment size in MB
MAX_ATTACHMENT_MB=25

# --- Self-update on boot (container) ---
# The container pulls the newest version of itself from this repo on boot.
SELF_UPDATE=true
REPO_URL=https://github.com/Phelcode/archipelago-discord-bridge.git
REPO_BRANCH=main
# Archipelago itself is NOT in this repo: the container clones it into
# AP_DIR=/opt/Archipelago on first boot and updates it to the newest version on
# every boot. Set AP_UPDATE=false to keep the existing copy.
AP_UPDATE=true
AP_REPO_URL=https://github.com/ArchipelagoMW/Archipelago.git
AP_BRANCH=main
# AP_PYTHON is preset in the image; override only if needed.
#AP_PYTHON=/opt/ap-venv/bin/python
