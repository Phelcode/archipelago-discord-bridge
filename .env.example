# --- Discord application (https://discord.com/developers/applications) ---
# Bot token of the application (used only for the REST API: registering slash
# commands and sending followup messages; the app never connects to the
# gateway and never reads messages).
DISCORD_TOKEN=
# Application ID
DISCORD_APPLICATION_ID=
# Public key of the application (used to verify interaction signatures)
DISCORD_PUBLIC_KEY=
# Discord user ID of the owner (has all permissions, can assign host roles)
DISCORD_OWNER_ID=
# Optional: restrict interactions to this guild ID
#DISCORD_GUILD_ID=

# --- Bridge ---
PORT=3000
# Data directory (mount as a volume in Docker so it survives updates)
DATA_DIR=/data
# Public hostname players use to connect to Archipelago servers
AP_SERVER_HOST=localhost
# First port used for Archipelago servers (one per running game)
BASE_PORT=38281
# Set to false to disable the /hints command
HINTS_ENABLED=true
# Max attachment size in MB
MAX_ATTACHMENT_MB=25

# --- Self-update on boot (container) ---
# The container pulls the newest version of itself from this repo on boot.
SELF_UPDATE=true
REPO_URL=https://github.com/Phelcode/archipelago-discord-bridge.git
REPO_BRANCH=main
# Archipelago source is also refreshed on boot
AP_UPDATE=true
AP_REPO_URL=https://github.com/ArchipelagoMW/Archipelago.git
AP_BRANCH=main
# AP_DIR and AP_PYTHON are preset in the image; override only if needed.
#AP_DIR=/opt/Archipelago
#AP_PYTHON=/opt/ap-venv/bin/python
