# --- Discord application (https://discord.com/developers/applications) ---
# Bot token of the application. The app connects to the Discord gateway with
# discord.js (heartbeat/resume handled by the library) and receives slash-command
# interactions there — no public URL or HTTPS inbound endpoint is needed.
DISCORD_TOKEN=
# Application ID
DISCORD_APPLICATION_ID=
# Discord user ID of the owner (has all permissions, can assign host roles)
DISCORD_OWNER_ID=
# Optional: comma-separated guild IDs where commands are additionally registered
# as guild commands (instant updates there). Does not restrict where the app
# answers — DMs and other guilds work regardless. Global commands are always
# registered too (propagate within ~1h).
#DISCORD_GUILD_ID=

# --- Bridge ---
PORT=3000
# Data directory (mount as a volume in Docker so it survives updates)
DATA_DIR=/data
# Public hostname players use to connect to Archipelago servers
AP_SERVER_HOST=localhost
# First port used for Archipelago servers (one per running game; games get
# BASE_PORT, BASE_PORT+1, ...). These ports must be reachable by players —
# the compose file publishes 38281-38290 by default; adjust both if you
# change BASE_PORT.
BASE_PORT=38281
# End of the published Archipelago port range (docker-compose only)
#AP_PORT_RANGE_END=38290
# Set to false to disable the /hints command
HINTS_ENABLED=true
# How often the watcher polls running games to DM blocked players about new
# items sent to them (milliseconds)
WATCH_INTERVAL_MS=30000
# Max attachment size in MB
MAX_ATTACHMENT_MB=25

# --- Self-update on boot (container) ---
# The container pulls the newest version of itself from this repo on boot.
SELF_UPDATE=true
REPO_URL=https://github.com/Phelcode/archipelago-discord-bridge.git
REPO_BRANCH=main
# Archipelago itself is NOT in this repo: the container clones it into
# AP_DIR=/opt/Archipelago on first boot and updates it to the newest version on
# every boot. Set AP_UPDATE=false to keep the existing copy.
AP_UPDATE=true
AP_REPO_URL=https://github.com/ArchipelagoMW/Archipelago.git
AP_BRANCH=main
# AP_PYTHON is preset in the image; override only if needed.
#AP_PYTHON=/opt/ap-venv/bin/python
